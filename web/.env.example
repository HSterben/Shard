# Must match the Convex deployment that serves /auth/* and account APIs
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Optional override; defaults to .convex.site derived from VITE_CONVEX_URL
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

VITE_WORKOS_CLIENT_ID=client_...
# Browser AuthKit return URL (web sign-in). Desktop uses Convex WORKOS_REDIRECT_URI.
# VITE_WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
