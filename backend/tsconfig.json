{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "strict": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["convex/**/*.ts"],
  "exclude": ["convex/_generated", "node_modules"]
}
